          },
          "expr": "(sum(rate(traefik_service_requests_total{service=~\".*-svc-web-web-v[12]-[0-9]+@kubernetesgateway\",code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(traefik_service_requests_total{service=~\".*-svc-web-web-v[12]-[0-9]+@kubernetesgateway\"}[$__rate_interval]))",
          "legendFormat": "",
