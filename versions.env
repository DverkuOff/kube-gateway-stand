# Pinned versions of every component. This file is the single place to change them.
# Sourced by deploy.sh and the CI pipelines. Plain KEY=value only (no shell logic).

# --- Kubernetes (pkgs.k8s.io) ---
KUBERNETES_MINOR=v1.36
KUBERNETES_VERSION=v1.36.5
KUBERNETES_PKG_VERSION=1.36.5-1.1
PAUSE_IMAGE=registry.k8s.io/pause:3.10.2

# --- Container runtime ---
# Default: containerd/runc from the Ubuntu archive (noble-updates); version is checked to be >= CONTAINERD_MIN_VERSION.
CONTAINERD_MIN_VERSION=2.0
# Used only with CONTAINERD_SOURCE=docker (hosts that already have Docker's containerd.io, e.g. GitHub runners).
CONTAINERD_IO_VERSION=2.3.6-1~ubuntu.24.04~noble

# --- Tooling ---
HELM_VERSION=v4.3.0

# --- Cluster add-ons ---
CALICO_VERSION=v3.32.2
LOCAL_PATH_VERSION=v0.0.37
GATEWAY_API_VERSION=v1.6.2
PROMETHEUS_OPERATOR_VERSION=v0.94.1
CERT_MANAGER_VERSION=v1.21.2

# --- Gateway ---
TRAEFIK_CHART_VERSION=41.6.1
TRAEFIK_VERSION=v3.7.13

# --- Demo application ---
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.30.5-alpine
NGINX_EXPORTER_IMAGE=nginx/nginx-prometheus-exporter:1.5.3

# --- Observability ---
KPS_CHART_VERSION=91.9.0
LOKI_CHART_VERSION=18.13.7
LOKI_VERSION=3.7.8
FLUENTD_CHART_VERSION=0.6.0
FLUENTD_BASE_IMAGE=fluent/fluentd-kubernetes-daemonset:v1.19.3-debian-forward-1.1
FLUENT_PLUGIN_LOKI_VERSION=1.3.0
FLUENTD_IMAGE=ghcr.io/dverkuoff/kube-gateway-stand/fluentd-loki
FLUENTD_IMAGE_TAG=v1.19.3-loki1.3.0
FLUENT_PLUGIN_LOKI_SHA256=a9fb5177bbe391da4fb1de434659125e5d39010b67340953742d68d9fddbf86c
